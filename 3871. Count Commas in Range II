//
Leetcode Link:-> https://leetcode.com/problems/count-commas-in-range-ii/description/
Approach:-> Maths.
//
class Solution {
public:
    long long countCommas(long long n) {
        if(n<1000)return 0;
        long long count=0;
        for(long long i=1000;i<=n;i=i*1000)count+=(n-i+1);
        return count;
    }
};
