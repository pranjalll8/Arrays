//
Leetcode Link:-> https://leetcode.com/problems/smallest-stable-index-i/
Approach used:-> prefix maximum element + suffix minimum element + simulation.
//
class Solution {
public:
    int firstStableIndex(vector<int>& nums, int k) {
        int n=nums.size();
        vector<int>prefix_max(n);
        vector<int>suffix_min(n);
        int maxi=0;
        int mini=INT_MAX;
        for(int i=0;i<n;i++){
            maxi=max(maxi,nums[i]);
            prefix_max[i]=maxi;
        }
        for(int i=n-1;i>=0;i--){
            mini=min(mini,nums[i]);
            suffix_min[i]=mini;
        }
        int ans=INT_MAX;
        int idx=-1;
        for(int i=0;i<n;i++){
            if(prefix_max[i]-suffix_min[i]<ans){
                ans=prefix_max[i]-suffix_min[i];
                idx=i;
                if(ans<=k)break;
            }
        }
        if(ans>k)return -1;
        return idx;
    }
};
